## Part 2: Explicit Prompt Signatures for the DSPy Governance Compiler
For ICML, we present the production-ready Python orchestration layer. This framework uses DSPy programmatic signatures to build our Governance-Aware Semantic Compiler (GASC). It replaces old-style hardcoded instructions with dynamic, policy-aware code compilation.

import dspyfrom typing import List, Dict, Any
# =====================================================================# DSPY SIGNATURE 1: METADATA & COMPLIANCE POLICY PRUNING# =====================================================================class PruneGovernanceMetadata(dspy.Signature):
    """
    Analyzes an ad-hoc database user query alongside a massive data catalog
    and outputs a minimal, security-compliant subset of schemas. It removes
    irrelevant schemas and applies active Row/Column-Level Security tags.
    """
    raw_user_query: str = dspy.InputField(desc="The conversational analytics query submitted by the user.")
    full_lakehouse_catalog: str = dspy.InputField(desc="Complete JSON string serialization of database schemas, columns, and metrics.")
    active_governance_policies: List[str] = dspy.InputField(desc="Active access privileges, masking rules, and compliance boundaries.")
    
    pruned_catalog_context: str = dspy.OutputField(desc="Pruned, high-density schema mapping containing ONLY the columns needed to answer the query safely.")
    applied_masking_directives: List[str] = dspy.OutputField(desc="Explicit column filtering or table restriction instructions required for down-stream compilation.")
# =====================================================================# DSPY SIGNATURE 2: COMPLIANCE-SAFE EXECUTABLE CODE GENERATION# =====================================================================class CompileSafeAnalyticsProgram(dspy.Signature):
    """
    Transforms the pruned metadata and user query into a secure, executable
    relational program (SQL or DataFrame code) that strictly adheres to the masking directives.
    """
    target_user_query: str = dspy.InputField(desc="The clean operational analytics goal.")
    secured_catalog_context: str = dspy.InputField(desc="The output framework generated by PruneGovernanceMetadata.")
    enforced_masking_directives: List[str] = dspy.InputField(desc="Active security filtering predicates that must be injected into code logic.")
    
    executable_code_block: str = dspy.OutputField(desc="Fully validated, production-grade executable SQL statement or PySpark execution logic.")
    compliance_justification: str = dspy.OutputField(desc="Rigorous trace log proving how the output script respects all active masking boundaries.")
# =====================================================================# PRODUCTION MODULE IMPLEMENTATION# =====================================================================class GovernanceAwareSemanticCompiler(dspy.Module):
    def __init__(self):
        super().__init__()
        # Leverage DSPy Predictive layers to handle signature tracking
        self.metadata_pruner = dspy.Predict(PruneGovernanceMetadata)
        self.program_compiler = dspy.Predict(CompileSafeAnalyticsProgram)
        
    def forward(self, user_query: str, catalog: Dict[str, Any], policies: List[str]) -> Dict[str, Any]:
        # Step 1: Prune metadata to minimize context inflation and enforce safety tags
        pruned_stage = self.metadata_pruner(
            raw_user_query=user_query,
            full_lakehouse_catalog=str(catalog),
            active_governance_policies=policies
        )
        
        # Step 2: Compile the clean schema subset into verified relational program code
        compiled_output = self.program_compiler(
            target_user_query=user_query,
            secured_catalog_context=pruned_stage.pruned_catalog_context,
            enforced_masking_directives=pruned_stage.applied_masking_directives
        )
        
        return {
            "safe_code": compiled_output.executable_code_block,
            "audit_trail": compiled_output.compliance_justification,
            "context_reduction_metrics": {
                "input_length_chars": len(str(catalog)),
                "optimized_length_chars": len(pruned_stage.pruned_catalog_context)
            }
        }


## Part 2: Automated Benchmark Processing Script
Target Execution: Sourcing and Preparing Spider 2.0 and AgentBench Records for the Multi-Agent Testing Pipelines
This production script connects directly to public benchmark endpoints via the datasets API, downloads the core Evaluation tables, and transforms the raw records into the exact Pydantic dataset profiles expected by our DSPy and LangGraph modules.

import osimport jsonimport loggingfrom typing import Dict, Any, Generatorfrom datasets import load_datasetfrom pydantic import BaseModel, Field
# Initialize execution logging configurations
logging.basicConfig(level=logging.INFO, format="%(asctime)s — %(levelname)s — %(message)s")logger = logging.getLogger("BenchmarkProcessor")
# =====================================================================# SYSTEM STRUCTURAL TARGET SCHEMAS# =====================================================================class StandardizedEvaluationRecord(BaseModel):
    evaluation_id: str = Field(..., description="Unique global identification tracking slug")
    origin_benchmark: str = Field(..., description="Source code identifier: SPIDER_2.0 or AGENTBENCH")
    system_intent_objective: str = Field(..., description="Clean baseline user target string passed to Step 0")
    ground_truth_target_logic: str = Field(..., description="The definitive executable target string or tool path sequence")
    context_schema_payload: Dict[str, Any] = Field(..., description="Context dictionary containing tables or environments")
# =====================================================================# AUTOMATED PIPELINE EXTRACTION FACTORY# =====================================================================class ResearchDataPipelineCollector:
    @staticmethod
    def extract_spider_2_0() -> Generator[StandardizedEvaluationRecord, None, None]:
        """
        Connects to the Spider 2.0 text-to-SQL repository, extracts multi-table
        schema requirements, and maps them to our standardized evaluation model.
        """
        logger.info("📡 Initializing download for Spider 2.0 enterprise schemas...")
        try:
            # Sourcing the formal validation splits representing complex join architectures
            dataset_stream = load_dataset("spider2/spider2", split="validation", streaming=True)
            
            for index, record in enumerate(dataset_stream):
                # Filter down the payload stream to isolate deeply nested relational patterns
                yield StandardizedEvaluationRecord(
                    evaluation_id=f"spider2-val-{index}-{record.get('instance_id', 'raw')}",
                    origin_benchmark="SPIDER_2.0",
                    system_intent_objective=record.get("question", ""),
                    ground_truth_target_logic=record.get("gold_query", ""),
                    context_schema_payload={
                        "db_id": record.get("db_id", "mock_enterprise_db"),
                        "schema_definition": record.get("db_schema", {}),
                        "foreign_keys": record.get("foreign_keys", [])
                    }
                )
        except Exception as error:
            logger.error(f"Failed to fetch Spider 2.0 pipeline data: {str(error)}")
            logger.info("Falling back to local simulation streaming for verification components.")
            yield StandardizedEvaluationRecord(
                evaluation_id="mock-spider2-001",
                origin_benchmark="SPIDER_2.0",
                system_intent_objective="Compute YoY operational margin variances across our restricted European entities.",
                ground_truth_target_logic="SELECT yoy_margin FROM eu_restricted_analytics_table WHERE region = 'EU'",
                context_schema_payload={"db_id": "eu_analytics", "tables": ["eu_restricted_analytics_table"]}
            )

    @staticmethod
    def extract_agentbench() -> Generator[StandardizedEvaluationRecord, None, None]:
        """
        Connects to the AgentBench evaluation corpus to pull complex multi-step
        OS, Bash, and web-agent command trajectories.
        """
        logger.info("📡 Connecting to AgentBench multi-turn validation targets...")
        try:
            # Pulling operational tool-use testing sets
            dataset_stream = load_dataset("THUDM/AgentBench", "os", split="test", streaming=True)
            
            for index, record in enumerate(dataset_stream):
                yield StandardizedEvaluationRecord(
                    evaluation_id=f"agentbench-os-{index}",
                    origin_benchmark="AGENTBENCH",
                    system_intent_objective=record.get("instruction", record.get("goal", "")),
                    ground_truth_target_logic=json.dumps(record.get("action_sequence", record.get("answer", []))),
                    context_schema_payload={
                        "initial_env_state": record.get("init_state", {}),
                        "available_tools": record.get("tools", ["bash_terminal", "filesystem_read"])
                    }
                )
        except Exception as error:
            logger.error(f"Failed to stream AgentBench data stream: {str(error)}")
            logger.info("Streaming fallback mock record for pipeline architecture testing.")
            yield StandardizedEvaluationRecord(
                evaluation_id="mock-agentbench-001",
                origin_benchmark="AGENTBENCH",
                system_intent_objective="Parse unformatted log blobs, map to transactional entries, check compliance flag, push to warehouse.",
                ground_truth_target_logic='["API::LogParser", "API::ComplianceValidator", "API::DataWarehouseConnector"]',
                context_schema_payload={"available_tools": ["bash_terminal", "internal_api_gateway"]}
            )
# =====================================================================# PIPELINE EXECUTION & LOCAL PACKAGING# =====================================================================if __name__ == "__main__":
    output_directory = "./research_baseline_payloads"
    os.makedirs(output_directory, exist_ok=True)
    
    collector = ResearchDataPipelineCollector()
    curated_evaluation_vault = []

    print("📊 Compiling Live Academic Evaluation Baseline Repositories...\n")
    
    # Process sample records from each stream to verify data integrity
    for record in collector.extract_spider_2_0():
        curated_evaluation_vault.append(record)
        break # Capturing the first valid high-density setup for structural inspection
        
    for record in collector.extract_agentbench():
        curated_evaluation_vault.append(record)
        break

    # Save target dataset profiles locally to disk
    output_path = os.path.join(output_directory, "standardized_baselines.json")
    with open(output_path, "w", encoding="utf-8") as file:
        json.dump([item.dict() for item in curated_evaluation_vault], file, indent=2)
        
    logger.info(f"✨ Production data-prep process completed successfully. Target data cached at: {output_path}")
    print(f"\nProcessed Record Example (JSON Serialization):\n{json.dumps(curated_evaluation_vault[0].dict(), indent=2)}")


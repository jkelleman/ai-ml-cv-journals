import numpy as npimport pandas as pdfrom typing import List, Dict, Any
class ResearchEvaluationEngine:
    def __init__(self, gamma: float = 0.15):
        self.gamma = gamma

    def _compute_shannon_entropy(self, probabilities: List[float]) -> float:
        """Calculates token distribution entropy."""
        arr = np.array(probabilities)
        return -np.sum(arr * np.log2(arr + 1e-12))

    def evaluate_trajectory_drift(self, v0: np.ndarray, vectors: List[np.ndarray], vocab_probs: List[List[float]]) -> Dict[str, Any]:
        """
        Computes local drift trajectories and returns the terminal Semantic Trust Index.
        """
        delta_list = []
        metrics_history = []
        
        for t, (v_t, p_t) in enumerate(zip(vectors, vocab_probs), start=1):
            # Compute cosine similarity
            cos_sim = float(np.dot(v_t, v0) / (np.linalg.norm(v_t) * np.linalg.norm(v0)))
            
            # Compute structural entropy penalty
            H_yt = self._compute_shannon_entropy(p_t)
            entropy_penalty = np.exp(-H_yt)
            
            # Formulate Local Semantic Divergence
            delta_t = float(1.0 - (cos_sim * entropy_penalty))
            delta_list.append(delta_t)
            
            # Compute cumulative ST_I up to step t
            weighted_sum = sum([ (i / t) * d for i, d in enumerate(delta_list, start=1) ])
            st_i = float(np.exp(-self.gamma * weighted_sum))
            
            metrics_history.append({
                "step": t,
                "cosine_similarity": round(cos_sim, 4),
                "shannon_entropy": round(H_yt, 4),
                "local_drift": round(delta_t, 4),
                "running_st_i": round(st_i, 4)
            })
            
        return {
            "terminal_st_i": metrics_history[-1]["running_st_i"],
            "step_logs": metrics_history
        }

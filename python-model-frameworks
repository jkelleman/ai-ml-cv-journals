import jsonimport uuidimport randomfrom typing import List, Dict, Any, Optionalfrom pydantic import BaseModel, Field
# =====================================================================# TRACK 1: NeurIPS - Semantic Drift & Trust Alignment Tracking Data# =====================================================================
class AgentTrajectoryStep(BaseModel):
    step_id: int = Field(..., description="Sequential index of agent communication handoff")
    agent_role: str = Field(..., description="Role profile of the active node (e.g., DataParser)")
    input_context: str = Field(..., description="Text or programmatic prompt state passed into the agent")
    output_response: str = Field(..., description="Raw text generation or action array outputted by the agent")
    latent_embedding_mock: List[float] = Field(..., description="Simulated 1536-dim normalized hidden state vector")
class SemanticDriftDatapoint(BaseModel):
    trajectory_id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    initial_user_constraint: str = Field(..., description="The definitive ground truth requirement set at step zero")
    trajectory: List[AgentTrajectoryStep] = Field(..., description="Full path trace of the multi-agent exchange")
    ground_truth_final_state: str = Field(..., description="Expected system outcome under perfect alignment")
    empirical_final_state: str = Field(..., description="The actual outcome generated at termination depth")
    measured_drift_score: float = Field(..., description="Mathematically derived token-entropy divergence metric")
# =====================================================================# TRACK 2: ICML - Governance Layering & Lakehouse Schema Analytics# =====================================================================
class MetricDefinition(BaseModel):
    metric_name: str
    calculation_formula: str
    governance_tags: List[str]
class ColumnSchema(BaseModel):
    name: str
    data_type: str
    security_classification: str = Field(..., description="RLS/CLS tags: e.g., RESTRICTED, PUBLIC")
class LakehouseTableSchema(BaseModel):
    table_name: str
    columns: List[ColumnSchema]
    row_count: int
class EnterpriseMetadataCatalog(BaseModel):
    catalog_id: str
    tables: List[LakehouseTableSchema]
    business_metrics: List[MetricDefinition]
class GovernanceOptimizationDatapoint(BaseModel):
    sample_id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    raw_user_query: str = Field(..., description="Ad-hoc conversational prompt targetting lakehouse tables")
    catalog_metadata: EnterpriseMetadataCatalog = Field(..., description="The enterprise schema catalog context")
    active_governance_policies: List[str] = Field(..., description="Active rows/column filtering restrictions")
    optimized_dspy_program_output: str = Field(..., description="Compiled code or structured logic following GASC pruning")
    compliance_validation_passed: bool = Field(True, description="Verification flag against policy violation checks")
# =====================================================================# TRACK 3: ICLR - Hierarchical Abstraction Layers & Prompt Grammars# =====================================================================
class OntologicalTier(BaseModel):
    tier_level: int = Field(..., description="1: Abstract Intent, 2: Structural Logic, 3: Operational Tool")
    tier_definition: str = Field(..., description="Boundary schema parsing directives")
    compiled_tokens: str = Field(..., description="Formatted instruction injections following HAP logic")
class HierarchicalPromptTemplate(BaseModel):
    prompt_id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    target_multi_step_task: str = Field(..., description="Complex cross-tool execution directive")
    hierarchical_layers: List[OntologicalTier] = Field(..., description="Decoupled conceptual prompt stacks")
    baseline_flat_prompt: str = Field(..., description="Standard un-abstracted long-string prompt for baseline comparisons")
    expected_tool_call_sequence: List[str] = Field(..., description="The precise sequence of API targets required")
# =====================================================================# TRACK 4: CVPR/ICCV - Multimodal VLM Evaluation & Chart Parsing# =====================================================================
class VisualGeometryElement(BaseModel):
    element_type: str = Field(..., description="e.g., bar_bounding_box, axis_line, legend_label")
    coordinates_xywh: List[float] = Field(..., description="Normalized pixel dimensions within image grid")
    ground_truth_value: Any = Field(..., description="The true underlying scalar datum mapped to this visual coordinate")
class MultimodalVLMDatapoint(BaseModel):
    image_id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    dashboard_image_path: str = Field(..., description="Local or cloud pointer to chart/dashboard rendering")
    raw_tabular_backend_data: Dict[str, List[Any]] = Field(..., description="True JSON source dataframe data rows")
    visual_annotations: List[VisualGeometryElement] = Field(..., description="Deceptive geometries or complex chart labels")
    analytical_question: str = Field(..., description="Analytical prompt requiring accurate data extraction")
    ground_truth_answer: str = Field(..., description="The indisputable true numeric response")
